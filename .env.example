# BigQuery credentials - use one of:
# 1. Path to service account JSON keyfile
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json

# 2. Or inline JSON (for serverless/Vercel) - the raw JSON content as string
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# BigQuery project and dataset (optional - defaults shown)
BIGQUERY_PROJECT=mimetic-perigee-290610
BIGQUERY_DATASET=obs_layer_poc_moomin
