# BigQuery credentials - use one of:
# 1. Path to service account JSON keyfile
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json

# 2. Or inline JSON (for serverless/Vercel) - the raw JSON content as string
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# BigQuery project, dataset and location (optional - defaults shown)
BIGQUERY_PROJECT=mimetic-perigee-290610
BIGQUERY_DATASET=obs_layer_northern_europe
# Dataset location (e.g. europe-north1 or EU) - must match where your dataset was created
BIGQUERY_LOCATION=europe-north1

# Optional: GA4 raw export datasets (for "Total events (raw GA4)" on Event Detail page)
# These should be the dataset names under your project, e.g. analytics_411471848
RAW_GA4_DATASET_MOOMIN_CLIENT=analytics_411471848
# RAW_GA4_DATASET_MOOMIN_SERVER=analytics_XXXXXXXXX
