{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd figma_spec && npm ci && npm run build",
  "outputDirectory": "figma_spec/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@3",
      "excludeFiles": "{tests/**,__tests__/**,**/*.test.py,**/test_*.py}"
    }
  }
}
